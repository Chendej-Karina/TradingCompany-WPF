<UserControl x:Class="TradingCompany.WPF.Views.AuctionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Аукціони" Style="{StaticResource TitleText}"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Content="Активні"
                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Active}"/>
            <RadioButton Content="Завершені"
                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Finished}"/>
            <Button Content="Оновити" Command="{Binding RefreshCommand}" Margin="16,0,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="Деактивувати вибраний аукціон" Command="{Binding DeactivateCommand}"
                    Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                    Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Auctions}" SelectedItem="{Binding SelectedAuction}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id, Mode=OneWay}" Width="50"/>
                <DataGridTextColumn Header="Товар" Binding="{Binding ItemName, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="Початок" Binding="{Binding StartDate, Mode=OneWay, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Завершення" Binding="{Binding EndDate, Mode=OneWay, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Стартова ціна" Binding="{Binding StartPriceText, Mode=OneWay}" Width="130"/>
                <DataGridTextColumn Header="Ціна викупу" Binding="{Binding BuyoutPriceText, Mode=OneWay}" Width="130"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText, Mode=OneWay}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
