<UserControl x:Class="TradingCompany.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:TradingCompany.WPF.Infrastructure">
    <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Вхід" Style="{StaticResource TitleText}"/>

            <TextBlock Text="Логін" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <TextBlock Text="Пароль" Margin="0,0,0,4"/>
            <PasswordBox infra:PasswordBoxHelper.Attach="True"
                         infra:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

            <Button Content="Увійти" Command="{Binding LoginCommand}" IsDefault="True" Margin="0"/>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12"
                       Text="Тестові користувачі: manager (менеджер аукціонів), viewer (лише перегляд), guest (без ролі)."/>
        </StackPanel>
    </Border>
</UserControl>
