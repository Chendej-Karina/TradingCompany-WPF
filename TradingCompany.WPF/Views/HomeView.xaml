<UserControl x:Class="TradingCompany.WPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Greeting}" Style="{StaticResource TitleText}"/>
        <TextBlock Text="{Binding RoleText}" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>

        <TextBlock Text="Сторінки вашої ролі" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <WrapPanel>
            <Button Command="{Binding OpenItemsCommand}" Width="220" Height="90" Margin="0,0,16,16"
                    Visibility="{Binding CanViewItems, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Товари" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="пошук, сортування, створення аукціону" FontSize="11" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenAuctionsCommand}" Width="220" Height="90" Margin="0,0,16,16"
                    Style="{StaticResource AccentButton}"
                    Visibility="{Binding CanViewAuctions, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Аукціони" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="активні та завершені" FontSize="11" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Button>
        </WrapPanel>
    </StackPanel>
</UserControl>
