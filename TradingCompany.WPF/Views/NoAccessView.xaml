<UserControl x:Class="TradingCompany.WPF.Views.NoAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Немає доступу" Style="{StaticResource TitleText}" Foreground="{StaticResource ErrorBrush}"/>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
