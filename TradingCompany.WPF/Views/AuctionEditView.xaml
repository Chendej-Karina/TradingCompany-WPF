<UserControl x:Class="TradingCompany.WPF.Views.AuctionEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="Новий аукціон" Style="{StaticResource TitleText}"/>

            <TextBlock Text="Товар" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding ItemName}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Валюта" Margin="0,0,0,14"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,14" ItemsSource="{Binding Currencies}"
                          DisplayMemberPath="Code" SelectedValuePath="Id" SelectedValue="{Binding CurrencyId}"/>

                <TextBlock Grid.Row="1" Text="Дата початку" Margin="0,0,0,14"/>
                <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,0,0,14" SelectedDate="{Binding StartDate}"/>

                <TextBlock Grid.Row="2" Text="Дата завершення" Margin="0,0,0,14"/>
                <DatePicker Grid.Row="2" Grid.Column="1" Margin="0,0,0,14" SelectedDate="{Binding EndDate}"/>

                <TextBlock Grid.Row="3" Text="Стартова ціна" Margin="0,0,0,14"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,14" Text="{Binding StartPrice, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="4" Text="Ціна викупу"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BuyoutPrice, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Зберегти" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}"/>
                <Button Content="Скасувати" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
